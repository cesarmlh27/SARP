# Backend / Docker deployment variables
SPRING_PROFILES_ACTIVE=prod

# Database
SPRING_DATASOURCE_USERNAME=user_sapr
SPRING_DATASOURCE_PASSWORD=replace_with_strong_db_password

# Security
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_EXPIRATION=86400000

# Frontend integration
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
APP_FRONTEND_URL=https://your-frontend-domain.com

# Bootstrap admin (first run)
MAIN_ADMIN_EMAIL=admin@sapr.com
MAIN_ADMIN_PASSWORD=replace_with_strong_admin_password

# Optional upload override
# UPLOAD_DIR=/app/uploads/products
